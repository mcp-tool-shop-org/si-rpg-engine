{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["packages/**/*.js", "packages/**/*.d.ts", "harness/**/*.js", "harness/**/*.mjs", "solver/lint.mjs", "solver/lint.test.js", "solver/source.test.js", "tools/verdicts.js", "tools/verdicts.test.js"]
}
